{
    "name": "Steward Development",

    "remoteEnv": {
        "VIRTUAL_ENV": "/workspace/backend/.venv",
        "PATH": "/workspace/backend/.venv/bin:${containerEnv:PATH}"
    },

    "dockerComposeFile": ["../compose.yml", "compose.devcontainer.yml"],

    "service": "workspace",
    "workspaceFolder": "/workspace",

    "shutdownAction": "stopCompose",
    "remoteUser": "vscode",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24.18.0"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.14.6"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",

                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",

                "formulahendry.auto-close-tag",
                "formulahendry.auto-rename-tag",

                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",

                "vscode-icons-team.vscode-icons"
            ],

            "settings": {
                "editor.formatOnSave": true,
                "editor.detectIndentation": false,
                "editor.insertSpaces": true,
                "editor.tabSize": 4,

                "workbench.iconTheme": "vscode-icons",

                "auto-close-tag.enableAutoCloseTag": true,
                "auto-close-tag.enableAutoCloseSelfClosingTag": true,
                "auto-close-tag.SublimeText3Mode": false,

                "auto-rename-tag.activationOnLanguage": [
                    "html",
                    "xml",
                    "javascript",
                    "javascriptreact",
                    "typescript",
                    "typescriptreact"
                ],

                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.tabSize": 4,
                    "editor.insertSpaces": true
                },

                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2,
                    "editor.insertSpaces": true,
                    "editor.formatOnSave": true
                },

                "[typescriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2,
                    "editor.insertSpaces": true,
                    "editor.formatOnSave": true
                },

                "[javascript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2,
                    "editor.insertSpaces": true,
                    "editor.formatOnSave": true
                },

                "[javascriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2,
                    "editor.insertSpaces": true,
                    "editor.formatOnSave": true
                },

                "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",

                "python.testing.pytestEnabled": true,
                "python.testing.cwd": "/workspace/backend",
                "python.testing.pytestArgs": ["src"],

                "js/ts.tsdk.path": "apps/web/frontend/node_modules/typescript/lib",

                "js/ts.format.insertSpaceAfterCommaDelimiter": true,
                "js/ts.format.insertSpaceAfterKeywordsInControlFlowStatements": true,
                "js/ts.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": true,
                "js/ts.format.insertSpaceBeforeAndAfterBinaryOperators": true
            }
        }
    },

    "forwardPorts": [5173, 8000],

    "portsAttributes": {
        "5173": {
            "label": "Steward Frontend",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "Steward Backend",
            "onAutoForward": "silent"
        }
    },

    "postCreateCommand": "/usr/local/python/current/bin/python -m pip install --user uv==0.11.32 && cd /workspace/backend && /home/vscode/.local/bin/uv sync --frozen"
}
