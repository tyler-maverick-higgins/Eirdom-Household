{
    "name": "Steward Development",

    "dockerComposeFile": [
        "../compose.yml",
        "compose.devcontainer.yml"
    ],

    "service": "workspace",
    "workspaceFolder": "/workspace",

    "shutdownAction": "stopCompose",
    "remoteUser": "vscode",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24.18.0"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.14.6"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "editor.formatOnSave": true,

                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },

                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },

                "[typescriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },

                "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.cwd": "/workspace/backend",
                "python.testing.pytestArgs": [
                    "src"
                ],

                "js/ts.tsdk.path": "apps/web/frontend/node_modules/typescript/lib"
            }
        }
    },

    "forwardPorts": [
        5173,
        8000
    ],

    "portsAttributes": {
        "5173": {
            "label": "Steward Frontend",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "Steward Backend",
            "onAutoForward": "silent"
        }
    },

    "postCreateCommand": "python -m pip install --user uv==0.11.32 && cd /workspace/backend && /home/vscode/.local/bin/uv sync --frozen"
}
