###############################################################################
# Eirdom Household Backend
#
# Copy this file to `.env` and update the values for your local environment.
#
# This file contains example values only and MUST NOT contain secrets.
#
# The actual `.env` file is ignored by Git.
###############################################################################

###############################################################################
# Django Configuration
###############################################################################

# Enable or disable Django debug mode.
#
# Development: true
# Production: false
DJANGO_DEBUG=true

# Django secret key.
#
# Generate a secure random key for each environment.
# Never commit production secrets to source control.
DJANGO_SECRET_KEY=replace-me

# Comma-separated list of allowed hostnames.
#
# Examples:
# localhost,127.0.0.1
# household.eirdom.homes
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

###############################################################################
# PostgreSQL Configuration
###############################################################################

# Database name
POSTGRES_DB=eirdom_household

# Database user
POSTGRES_USER=eirdom

# Database password
#
# Replace with a secure password.
POSTGRES_PASSWORD=replace-me

# PostgreSQL hostname.
#
# When running with Docker Compose this should match the service name.
POSTGRES_HOST=database

# PostgreSQL port
POSTGRES_PORT=5432
